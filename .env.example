# ============================================================
# AI Engineer Mentor — 环境变量示例
# 复制为 .env 后填入真实值（.env 已被 .gitignore 排除，不会提交）
# ============================================================

# ── AI 对话 API ─────────────────────────────────────────────
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://vg.v1api.cc/v1
AI_MODEL=gpt-3.5-turbo

# ── Embedding 模型（知识库向量化）────────────────────────────
EMBED_MODEL=text-embedding-ada-002

# ── Tavily 网络搜索（可选）──────────────────────────────────
# 免费注册：https://tavily.com  每月 1000 次免费
# 不填则跳过网络搜索，其他功能不受影响
TAVILY_API_KEY=your_tavily_key_here

# ── Flask（可选）───────────────────────────────────────────────
# 留空则每次启动随机生成（重启后登录态失效）
# FLASK_SECRET_KEY=your_custom_secret